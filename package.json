{
    "name": "@chelohubinc/ae-downgrader-engine",
    "version": "0.1.1",
    "description": "Independent engine (browser/Node) for .aep file detection and backward compatibility",
    "author": "Chelohub Inc. <npm@borislukrece.com>",
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "release:patch": "npm version patch && git push origin HEAD --follow-tags",
        "release:minor": "npm version minor && git push origin HEAD --follow-tags",
        "release:major": "npm version major && git push origin HEAD --follow-tags",
        "test": "vitest run"
    },
    "directories": {
        "test": "tests"
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        }
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "tsup": "^9.0.0",
        "typescript": "^5.6.0",
        "vitest": "^2.1.0"
    },
    "files": [
        "dist", "README.md", "LICENCE"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/chelohubinc/ae-downgrader-engine"
    },
    "keywords": [
        "after effects",
        "aep",
        "downgrade",
        "engine",
        "browser",
        "node"
    ],
    "license": "ISC",
    "publishConfig": { "access": "public" },
    "sideEffects": false,
    "engines": {
        "node": ">=18"
    }
}
