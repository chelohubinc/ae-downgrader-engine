{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "lib": ["ES2022", "DOM"],
        "types": ["node"],
        "skipLibCheck": true
    },
    "include": ["src", "tests"],
    "exclude": [
        "dist",
        "node_modules",
    ]
}
